#!/usr/bin/env bash
set -eu
case "$1" in
  -l)
    [[ "${*:2}" == '-E sha256 -f /dev/stdin' ]]
    content=$(cat)
    case "$content" in
      *'fixture-id: '*) id=${content##*fixture-id: } ;;
      'ssh-ed25519 '*) id=${content#ssh-ed25519 }; id=${id%% *} ;;
      *) exit 1 ;;
    esac
    printf '256 SHA256:%s fixture (ED25519)\n' "$id"
    ;;
  -y)
    [[ ${MOCK_RECOVERY:-ok} == ok ]] || { echo partial; exit 1; }
    id=$(sed -n 's/^fixture-id: //p' "${!#}")
    printf 'ssh-ed25519 %s\n' "$id" ;;
  *)
    while (($#)); do
      case "$1" in -f) key=$2; shift ;; -C) email=$2; shift ;; esac
      shift
    done
    case "$email" in second*) id=secondary ;; *) id=personal ;; esac
    printf '%s\nfixture-id: %s\n' '-----BEGIN OPENSSH PRIVATE KEY-----' "$id" > "$key"
    printf 'ssh-ed25519 %s\n' "$id" > "$key.pub"
    echo generated >> "$HOME/keygen-trace" ;;
esac
